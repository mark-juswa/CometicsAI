{
  "name": "beautycore",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:recovery": "node --experimental-test-module-mocks --import tsx --test tests/generation-store.test.ts tests/generation-navigation.test.tsx tests/generation-auth.test.mjs",
    "dev": "node scripts/start-portal.mjs --dev",
    "build": "next build",
    "start": "node scripts/start-portal.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test:business": "node --experimental-test-module-mocks --import tsx --test --test-concurrency=1 tests/business-workflows.test.ts tests/business-ui.test.mjs tests/finance-stats.test.mjs tests/saved-look-migrations.test.ts tests/look-information.test.ts tests/service-completion.test.ts tests/additional-features.test.ts tests/auth-response.test.ts tests/revenue-report.test.ts tests/appointment-list.test.ts tests/saved-look-retry.test.ts tests/saved-look-image.test.ts tests/service-lifecycle.test.ts tests/no-show-worker.test.mjs tests/inventory-management.test.ts",
    "db:check:saved-looks": "tsx scripts/apply-saved-looks.ts --check",
    "db:apply:enhancements": "tsx scripts/apply-saved-looks.ts --apply --additional-only --schema-only",
    "test:guest-trial": "node --experimental-test-module-mocks --import tsx --test tests/guest-trial.test.ts tests/guest-trial-ui.test.mjs",
    "db:check:guest-trial": "tsx scripts/apply-guest-trial.ts --check",
    "test:style-release": "node --experimental-test-module-mocks --import tsx --test tests/style-release.test.ts tests/ai-runtime-registry.test.ts",
    "db:apply:scheduling": "tsx scripts/apply-booking-scheduling.ts --apply",
    "db:apply:booking-context": "tsx scripts/apply-booking-context.ts --apply",
    "worker:no-shows": "node scripts/no-show-worker.mjs",
    "db:apply:service-lifecycle": "tsx scripts/apply-service-lifecycle.ts --apply",
    "db:apply:inventory": "tsx scripts/apply-inventory.ts --apply"
  },
  "dependencies": {
    "@google/genai": "^1.31.0",
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "jose": "^6.1.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3"
  }
}
